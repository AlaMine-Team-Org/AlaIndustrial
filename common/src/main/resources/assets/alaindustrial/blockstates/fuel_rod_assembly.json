    },
    {
      "when": {
        "rods": "3|4",
        "fuelled": "0|1|2",
        "up": "true"
      },
      "apply": {
        "model": "alaindustrial:block/fuel_rod_assembly_empty_c_up"
      }
    },
    {
      "when": {
        "fuelled": "3|4",
        "down": "true"
      },
      "apply": {
        "model": "alaindustrial:block/fuel_rod_assembly_rod_c_down"
      }
    },
    {
      "when": {
        "rods": "3|4",
