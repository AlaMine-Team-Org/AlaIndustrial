{
  "multipart": [
    {
      "apply": {
        "model": "alaindustrial:block/fuel_rod_assembly_core"
      }
    },
    {
      "when": {
        "up": "false",
        "down": "false"
      },
      "apply": {
        "model": "alaindustrial:block/fuel_rod_assembly_shell"
      }
    },
    {
      "when": {
        "up": "true",
        "down": "false"
      },
      "apply": {
        "model": "alaindustrial:block/fuel_rod_assembly_shell_up"
      }
    },
    {
      "when": {
        "up": "false",
        "down": "true"
      },
      "apply": {
        "model": "alaindustrial:block/fuel_rod_assembly_shell_down"
      }
    },
    {
      "when": {
        "up": "true",
        "down": "true"
      },
      "apply": {
        "model": "alaindustrial:block/fuel_rod_assembly_shell_up_down"
      }
    },
    {
      "when": {
        "up": "false"
      },
      "apply": {
        "model": "alaindustrial:block/fuel_rod_assembly_cap"
      }
    },
    {
      "when": {
        "down": "false"
      },
      "apply": {
        "model": "alaindustrial:block/fuel_rod_assembly_base"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "alaindustrial:block/fuel_rod_assembly_column_up"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "alaindustrial:block/fuel_rod_assembly_column_down"
      }
    },
    {
      "when": {
        "fuelled": "1|2|3|4"
      },
      "apply": {
        "model": "alaindustrial:block/fuel_rod_assembly_rod_a"
      }
    },
    {
      "when": {
        "rods": "1|2|3|4",
        "fuelled": "0"
      },
      "apply": {
        "model": "alaindustrial:block/fuel_rod_assembly_empty_a"
      }
    },
    {
      "when": {
        "fuelled": "1|2|3|4",
        "up": "true"
      },
      "apply": {
        "model": "alaindustrial:block/fuel_rod_assembly_rod_a_up"
      }
    },
    {
      "when": {
        "rods": "1|2|3|4",
        "fuelled": "0",
        "up": "true"
      },
      "apply": {
        "model": "alaindustrial:block/fuel_rod_assembly_empty_a_up"
      }
    },
    {
      "when": {
        "fuelled": "1|2|3|4",
        "down": "true"
      },
      "apply": {
        "model": "alaindustrial:block/fuel_rod_assembly_rod_a_down"
      }
    },
    {
      "when": {
        "rods": "1|2|3|4",
        "fuelled": "0",
        "down": "true"
      },
      "apply": {
        "model": "alaindustrial:block/fuel_rod_assembly_empty_a_down"
      }
    },
    {
      "when": {
        "fuelled": "2|3|4"
      },
      "apply": {
        "model": "alaindustrial:block/fuel_rod_assembly_rod_b"
      }
    },
    {
      "when": {
        "rods": "2|3|4",
        "fuelled": "0|1"
